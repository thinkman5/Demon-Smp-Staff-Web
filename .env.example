# ---------------------------------------------------------------------------
# DEMON SMP Panel — environment configuration
# Copy to `.env` and adjust. Every value is optional unless marked.
# ---------------------------------------------------------------------------

# --- Network ---------------------------------------------------------------
# The panel listens on HOST:PORT. Behind a router, keep HOST=0.0.0.0 so the
# port-forward rule can reach it.
PORT=8080
HOST=0.0.0.0

# --- Security --------------------------------------------------------------
# REQUIRED in production. Signs JWTs; if omitted a secret is generated once and
# persisted to data/.jwt-secret (logins then survive restarts, but rotating the
# value invalidates every session).
# JWT_SECRET=replace-with-a-long-random-string

# Session lifetime in hours (default 12).
# SESSION_HOURS=12

# Comma-separated extra origins allowed to call the API, e.g.
# "http://192.168.1.50:8080,https://panel.example.com". Leave empty to reflect
# any origin (safe here: the API authenticates with Bearer tokens, not cookies).
# ALLOWED_ORIGINS=

# Set true ONLY when the panel runs behind a reverse proxy / tunnel (Render,
# Railway, Cloudflare Tunnel, nginx) so rate limiting sees the real client IP.
# Leave unset for direct router port-forwarding.
# TRUST_PROXY=false

# --- Bootstrap admin -------------------------------------------------------
# Only used on the very first start (empty JSON store and empty database).
# If ADMIN_PASSWORD is omitted, a random one is generated and printed once.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Storage ---------------------------------------------------------------
# Where JSON state lives (users, settings, audit, console log, JWT secret).
# DATA_DIR=./data

# Optional PostgreSQL backend (Netlify DB / Neon / Supabase / Render / local).
# Leave EMPTY to use the default JSON files. When set, panel accounts, settings
# and the audit trail are stored in Postgres (table: panel_kv) and the JSON
# files are kept as a local cache/fallback.
#   Netlify DB  → copy the connection string from the Netlify DB dashboard
#   Neon        → postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
#   Supabase    → postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# The following aliases are all recognised: DATABASE_URL, NETLIFY_DATABASE_URL,
# NETLIFY_DB_URL, POSTGRES_URL, POSTGRES_PRISMA_URL, NEON_DATABASE_URL.
# DATABASE_URL=

# Set to "disable" to force TLS off (local Postgres). Managed providers imply TLS.
# PGSSLMODE=

# --- Managed server process (first boot only; edit in Server Options later) --
# SERVER_COMMAND=java
# SERVER_CWD=.
# SERVER_ARGS=-Xmx4G -Xms2G -jar server.jar nogui
